<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:paddingBottom="12dp"
            android:text="@string/tutorial_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:lineSpacingExtra="4dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnTutRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="@string/tut_read" />

        <Button
            android:id="@+id/btnTutNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/tut_next" />

        <Button
            android:id="@+id/btnTutPrev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/tut_prev" />

        <Button
            android:id="@+id/btnTutDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/tut_demo" />

        <Button
            android:id="@+id/btnTutBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="64dp"
            android:text="@string/btn_back" />
    </LinearLayout>
</ScrollView>
